* text=auto
* text eol=lf

# Windows forced line-endings
/.idea/* text eol=crlf

# Gradle wrapper
*.jar binary

# MihonSY: native / ML artifacts must never be line-ending converted.
# "*.a" archives start with the ASCII magic "!<arch>" so Git's text
# auto-detection treats them as text and CRLF->LF conversion corrupts
# the archive (verified: libncnn.a lost 94 bytes).
*.a binary
*.so binary
*.o binary
*.bin binary
*.param binary

# Images
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.pyc binary
*.swp binary
